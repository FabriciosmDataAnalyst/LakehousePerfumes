{
  "datasets": [
    {
      "name": "ds_comercial",
      "displayName": "Vendas",
      "queryLines": [
        "SELECT\n",
        "  data_pedido,\n",
        "  ano,\n",
        "  canal,\n",
        "  segmento,\n",
        "  cidade,\n",
        "  marca,\n",
        "  categoria,\n",
        "  pedido_id,\n",
        "  razao_social,\n",
        "  receita AS receita_linha,\n",
        "  margem AS margem_linha,\n",
        "  custo AS custo_linha\n",
        "FROM fato_vendas"
      ],
      "catalog": "lakehouse_rotaperfume",
      "schema": "gold",
      "columns": [
        {
          "displayName": "Receita",
          "description": "Soma da receita da gold.fato_vendas. Nome canonicamente gerado por algo em um lugar so - nenhuma tela mostra numero diferente.",
          "expression": "SUM(`receita_linha`)"
        },
        {
          "displayName": "Margem",
          "description": "Soma da margem da gold.fato_vendas (receita menos custo).",
          "expression": "SUM(`margem_linha`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Pedidos distintos no periodo.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Medio",
          "description": "Receita por pedido.",
          "expression": "SUM(`receita_linha`) / NULLIF(COUNT(DISTINCT `pedido_id`), 0)"
        },
        {
          "displayName": "Margem Pct",
          "description": "Margem percentual sobre a receita no grau escolhido pelo widget.",
          "expression": "100 * SUM(`margem_linha`) / NULLIF(SUM(`receita_linha`), 0)"
        }
      ]
    }
  ],
